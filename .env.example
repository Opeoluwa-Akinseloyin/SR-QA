# API keys for this project. NEVER commit this file - .gitignore excludes it.
#
# Paste each key after the '=' with no quotes and no spaces, e.g.
#   OPENROUTER_API_KEY=sk-or-v1-abc123...
#
# An empty value is ignored, and a real environment variable always wins over
# this file, so anything you already set with `setx` keeps working unchanged.
#
# This file is also `source`-able from Git Bash:  . .env

OPENROUTER_API_KEY=

# Already set at the Windows user level - listed here only so the file is a
# complete picture. Leave them empty unless you want the file to be the source
# of truth for them too.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
